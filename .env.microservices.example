# Shared across all services — copy to .env in each service folder, or set globally

# Database (same DB, all services share it)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs_platform_dev"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Service ports (optional — defaults shown)
# AUTH_PORT=4001
# USER_PORT=4002
# CONTENT_PORT=4003
# ASSESSMENT_PORT=4004
# INTERVIEW_PORT=4005
# MASTERY_PORT=4006
# AI_PORT=4007

# Inter-service URLs (used by services that call each other)
AI_SERVICE_URL=http://localhost:4007
MASTERY_SERVICE_URL=http://localhost:4006

# Gateway
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
CONTENT_SERVICE_URL=http://localhost:4003
ASSESSMENT_SERVICE_URL=http://localhost:4004
INTERVIEW_SERVICE_URL=http://localhost:4005
